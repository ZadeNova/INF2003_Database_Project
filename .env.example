# Generated locally by src/tools/init_env.py. Never commit .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_PORT=8000
POSTGRES_DB=mercer
# Owner: owns the database, runs migrations, the importer and pytest. Runtime: used by the web service (rows only).
POSTGRES_OWNER_USER=mercer_owner
POSTGRES_OWNER_PASSWORD=replace-owner-password
POSTGRES_RUNTIME_USER=mercer_runtime
POSTGRES_RUNTIME_PASSWORD=replace-runtime-password
POSTGRES_ADMIN_PASSWORD=replace-admin-password
# MongoDB: the root user only initialises the replica set; the application user is readWrite on MONGO_DB and test_<MONGO_DB>.
MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=replace-mongo-root-password
MONGO_APP_USER=mercer_mongo
MONGO_APP_PASSWORD=replace-mongo-app-password
MONGO_DB=mercer
# Host port for tools outside Compose (connect with directConnection=true).
MONGO_PORT=27017
# Demo logins are seeded by the owner service only. The values are fixed and documented in the README so anyone can
# log in to a local copy; they are not secrets and the app is never deployed. Set all three; there is no fallback.
DEMO_CUSTOMER_PASSWORD=mercer-demo-customer
DEMO_SELLER_PASSWORD=mercer-demo-seller
DEMO_OPERATOR_PASSWORD=mercer-demo-operator

# Isolated bench profile. Never use application credentials or volumes for a benchmark.
BENCH_DB=bench
BENCH_ADMIN_PASSWORD=replace-bench-admin-password
BENCH_OWNER_USER=bench_owner
BENCH_OWNER_PASSWORD=replace-bench-owner-password
BENCH_RUNTIME_USER=bench_runtime
BENCH_RUNTIME_PASSWORD=replace-bench-runtime-password
BENCH_MONGO_ROOT_USER=bench_root
BENCH_MONGO_ROOT_PASSWORD=replace-bench-mongo-root-password
BENCH_MONGO_USER=bench_mongo
BENCH_MONGO_PASSWORD=replace-bench-mongo-password
