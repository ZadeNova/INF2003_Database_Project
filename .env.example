# Copy to .env and adjust. .env is gitignored — never commit real credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

MONGO_USER=root
MONGO_PASSWORD=root

# Used by the backend when run outside Docker; compose overrides these with
# container hostnames.
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/app
MONGO_URI=mongodb://localhost:27017
MONGO_DB=app

DEBUG=true

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
